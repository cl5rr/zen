welcome {
    off
}

hotkey-overlay {
    skip-at-startup
}

prefer-no-csd

cursor {
    hide-after-inactive-ms 3000
}

glass {
    opacity 0.08
    tint "#ffffff"
    refraction 22
    falloff 14
    saturation 1.25
    specular 0.55
}

blur {
    passes 1
    offset 1
}

layer-rule {
    match namespace="^zen-greeter-glass$"
    background-effect {
        glass true
        blur true
        alpha-mask true
    }
}

binds {
}

spawn-sh-at-startup "zen-greeter --shell; zen msg action quit --skip-confirmation"
