{
    "include": ["~/.config/waybar/zen-modules.jsonc"],

    "layer": "top",
    "position": "top",
    "height": 34,
    "margin-top": 8,
    "margin-left": 12,
    "margin-right": 12,
    "spacing": 8,
    "exclusive": true,
    "mode": "dock",

    "modules-left": ["niri/workspaces", "niri/window"],
    "modules-center": ["clock"],
    "modules-right": ["tray", "pulseaudio", "backlight", "battery", "network", "custom/power"]
}
